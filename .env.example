# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Storage
# Project: https://supabase.com/dashboard/project/brnhalxydcakutxiregp
VITE_SUPABASE_URL="https://brnhalxydcakutxiregp.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Persistent social login encryption (or reuse BLUESKY_SESSION_SECRET).
SOCIAL_SESSION_SECRET=""

# Social publishing setup
# APP_URL must be the exact public URL of this app, for example:
# APP_URL="http://localhost:3000" for local testing
# APP_URL="https://your-vercel-site.vercel.app" after deployment

# Meta credentials for Facebook Page authorization.
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business configuration ID (optional).
META_LOGIN_CONFIG_ID=""
META_FACEBOOK_PAGE_ID=""

# LinkedIn personal profile: enable OpenID Connect and Share on LinkedIn.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_VERSION=""

# TikTok Content Posting API.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Bluesky session encryption. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set in the server's production environment, never with a VITE_ prefix.
BLUESKY_SESSION_SECRET=""
# Optional additional trusted HTTPS image hosts (comma-separated).
BLUESKY_MEDIA_HOSTS=""

# Optional extra trusted HTTPS image hosts for LinkedIn and Bluesky.
PUBLISHING_MEDIA_HOSTS=""
# Q website publishing: connect its CRM-issued API token in the manager UI.
# No website API token or Supabase service-role key is stored in frontend env vars.
