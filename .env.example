# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Storage
# Project: https://supabase.com/dashboard/project/brnhalxydcakutxiregp
VITE_SUPABASE_URL="https://brnhalxydcakutxiregp.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Social publishing setup
# APP_URL must be the exact public URL of this app, for example:
# APP_URL="http://localhost:3000" for local testing
# APP_URL="https://your-vercel-site.vercel.app" after deployment

# Meta powers Instagram, Threads, and Facebook Page authorization.
META_APP_ID=""
META_APP_SECRET=""
META_FACEBOOK_PAGE_ID=""
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=""
META_THREADS_USER_ID=""

# LinkedIn organization publishing.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ORGANIZATION_ID=""

# X / Twitter OAuth 2.0 publishing.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# TikTok Content Posting API.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Bluesky / AT Protocol.
BLUESKY_HANDLE=""
BLUESKY_APP_PASSWORD=""

# Official website publishing target.
Q_WEBSITE_PUBLISH_ENDPOINT=""
Q_WEBSITE_PUBLISH_SECRET=""
